[Unit]
Description=Refresh Arvento consolidated report cache at 08:00, 12:30 and 20:00

[Timer]
OnCalendar=*-*-* 08:00:00 Europe/Istanbul
OnCalendar=*-*-* 12:30:00 Europe/Istanbul
OnCalendar=*-*-* 20:00:00 Europe/Istanbul
Persistent=true
AccuracySec=1min
RandomizedDelaySec=0
Unit=arvento-consolidated-cache.service

[Install]
WantedBy=timers.target
