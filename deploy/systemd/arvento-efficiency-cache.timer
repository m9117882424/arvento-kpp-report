[Unit]
Description=Warm Arvento efficiency GPS metrics after the nightly source cache

[Timer]
OnCalendar=*-*-* 04:40:00 Europe/Istanbul
# Do not catch up a missed CPU-heavy warmup during business hours.
Persistent=false
AccuracySec=1min
RandomizedDelaySec=0
Unit=arvento-efficiency-cache.service

[Install]
WantedBy=timers.target
