# Include inside the HTTPS server for bdd.equippulse.com, after server-level
# auth_basic /etc/nginx/.htpasswd_bdd.  Do not expose port 18083 publicly.
# The user-specific password file contains ONLY the existing maksim hash.

location = /geozones {
    return 308 /geozones/;
}

location ^~ /geozones/ {
    auth_basic "Arvento Reports";
    auth_basic_user_file /etc/nginx/.htpasswd_bdd_geozones_maksim;

    # Trailing slash strips the /geozones/ prefix for the local editor.
    proxy_pass http://127.0.0.1:18083/;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_connect_timeout 10s;
    proxy_read_timeout 60s;
}

# This ONLY controls whether to display a menu item.  All actual geofence
# permissions are enforced separately by Nginx on /geozones/ and its API.
location = /api/efficiency/admin-tools {
    # Inherits the main BDD Basic Auth; never disable authentication here.
    proxy_pass http://127.0.0.1:18084;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Arvento-Authenticated-User $remote_user;
    proxy_connect_timeout 10s;
    proxy_read_timeout 30s;
}
