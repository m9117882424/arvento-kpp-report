# PostgreSQL. Generate a URL-safe password, for example:
#   openssl rand -hex 32
POSTGRES_DB=arvento_report
POSTGRES_USER=arvento_report
POSTGRES_PASSWORD=CHANGE_ME_LONG_RANDOM_PASSWORD
DATABASE_URL=postgresql://arvento_report:CHANGE_ME_LONG_RANDOM_PASSWORD@postgres:5432/arvento_report
POSTGRES_SHM_SIZE=256m

# Arvento API credentials. Never commit populated values.
ARVENTO_USER=
ARVENTO_PIN1=
ARVENTO_PIN2=
ARVENTO_GROUP=TSM

# API synchronization parameters.
ARVENTO_SYNC_INTERVAL_SECONDS=1800
ARVENTO_SYNC_LOOKBACK_HOURS=6
ARVENTO_CHUNK_MINUTES=120
ARVENTO_MINUTE_DIF=180
ARVENTO_RETENTION_DAYS=60
ARVENTO_HTTP_TIMEOUT=180
ARVENTO_HTTP_RETRIES=3

# systemd pipeline limits. A timeout terminates the Docker job and prevents an
# unbounded process from blocking all following timer runs.
PIPELINE_INTRADAY_TIMEOUT_SECONDS=2700
PIPELINE_NIGHTLY_TIMEOUT_SECONDS=7200
PIPELINE_DISTANCE_TIMEOUT_SECONDS=600
PIPELINE_CACHE_TIMEOUT_SECONDS=3600

# Hybrid mileage selection. VehicleDistanceReport remains authoritative unless
# it exceeds coordinate mileage by both limits below.
CONSOLIDATED_HYBRID_ABSOLUTE_GAP_KM=10
CONSOLIDATED_HYBRID_RATIO=1.20

# Daily pg_dump backup outside the repository. Backup shares the main pipeline
# lock so it cannot add load during sync/cache processing.
BACKUP_DIR=/opt/arvento_backups
BACKUP_RETENTION_DAYS=14
BACKUP_PIPELINE_LOCK_WAIT_SECONDS=600
BACKUP_DUMP_TIMEOUT_SECONDS=2700
BACKUP_VERIFY_TIMEOUT_SECONDS=300

# Health check threshold.
MIN_FREE_DISK_PERCENT=10

# Docker resource and log limits. Adjust for the target server before install.
DOCKER_LOG_MAX_SIZE=20m
DOCKER_LOG_MAX_FILES=5
GPS_SYNC_CPU_LIMIT=1.0
GPS_SYNC_MEMORY_LIMIT=1g
GPS_SYNC_PIDS_LIMIT=256
GPS_SYNC_TMPFS_SIZE=256m
GEOFENCE_EDITOR_CPU_LIMIT=1.0
GEOFENCE_EDITOR_MEMORY_LIMIT=768m
GEOFENCE_EDITOR_PIDS_LIMIT=192
GEOFENCE_EDITOR_TMPFS_SIZE=128m
REPORT_PORTAL_CPU_LIMIT=2.0
REPORT_PORTAL_MEMORY_LIMIT=2g
REPORT_PORTAL_PIDS_LIMIT=384
REPORT_PORTAL_TMPFS_SIZE=1g
ARVENTO_IMAGE_TAG=local

# Read-only PostgreSQL connection to the Fuel Monitor project.
# Leave empty to keep the rightmost "Заправка, л" column blank.
FUEL_DATABASE_URL=
FUEL_DB_CONNECT_TIMEOUT_SECONDS=10

# Read-only JSON API for the external passenger-fleet dashboard. Generate a
# separate URL-safe secret, for example: openssl rand -hex 32
FLEET_API_TOKEN=
FLEET_API_MAX_PERIOD_DAYS=93
FLEET_API_STATEMENT_TIMEOUT_MS=15000
FLEET_API_OFFLINE_MINUTES=180
FLEET_API_MOVING_SPEED_KMH=3

# Geofence editor. Empty Google key means immediate OpenStreetMap fallback.
GOOGLE_MAPS_API_KEY=
DEFAULT_MAP_PROVIDER=google
OSM_FALLBACK_ENABLED=true
MAP_CENTER_LAT=36.145
MAP_CENTER_LON=33.535
MAP_DEFAULT_ZOOM=15
GEOFENCE_EDITOR_PORT=18083

# Report portal. Keep bound to localhost and expose through Nginx.
REPORT_PORTAL_PORT=18084
