FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app \
    TZ=Europe/Istanbul

WORKDIR /app

RUN apt-get update \
    && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends tzdata ca-certificates tk \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt /app/requirements.txt
RUN pip install --no-cache-dir -r /app/requirements.txt

COPY . /app
RUN python /app/verify_repository.py \
    && ARVENTO_RUNTIME_CHECK_STRICT=1 python /app/verify_runtime.py \
    && python /app/verify_left_turn_runtime.py

CMD ["python", "sync_arvento_gps_to_postgres.py", "daemon"]
